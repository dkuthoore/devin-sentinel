# --- Required (no safe default; Sentinel will fail without these) ---

# Devin v3 API (service user key + org ID).
# Org ID: Devin Settings → Service users (prefix org-).
DEVIN_API_KEY=
DEVIN_ORG_ID=

# GitHub token (issues + PRs) and fork to monitor.
GITHUB_TOKEN=
GITHUB_REPO=yourusername/superset



# --- Optional (defaults in orchestrator/config.py) ---

# Devin API base URL (default: production v3).
DEVIN_BASE_URL=https://api.devin.ai/v3

# GitHub polling behavior.
GITHUB_POLL_ENABLED=1
GITHUB_PUSH_POLL_ENABLED=1
GITHUB_DEFAULT_BRANCH=master

# Local runtime / tuning.
DATABASE_URL=sqlite:///./sentinel.db
POLL_INTERVAL_SECONDS=5
DEVIN_RECONCILE_INTERVAL_SECONDS=30
DEVIN_SESSION_LOOKBACK_HOURS=12
DASHBOARD_PATH=dashboard/index.html
